{
  "name": "workbuddy-openai-bridge",
  "version": "1.0.0",
  "description": "Turn a WorkBuddy desktop app sign-in into a standard OpenAI-compatible endpoint, and expose those models to Pi (pi-coding-agent) and MolaGPT.",
  "keywords": [
    "workbuddy",
    "codebuddy",
    "deepseek-harness",
    "dsh",
    "openai-compatible",
    "pi-coding-agent",
    "molagpt",
    "bridge",
    "proxy"
  ],
  "license": "MIT",
  "author": "Huanyuee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Huanyuee/workbuddy-openai-bridge.git"
  },
  "homepage": "https://github.com/Huanyuee/workbuddy-openai-bridge#readme",
  "bugs": {
    "url": "https://github.com/Huanyuee/workbuddy-openai-bridge/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "bin": {
    "workbuddy-bridge": "bin/bridge.js",
    "workbuddy-setup-molagpt": "bin/setup-molagpt.js",
    "workbuddy-cert": "bin/cert.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./extension": "./extensions/workbuddy.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "extensions",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "//dependencies": "dsh-workbuddy-connect declares its entire runtime surface as peerDependencies, and `pi install` runs npm with --omit=dev --omit=peer. Without listing the closure here the extension fails to load with 'Cannot find module ...'. Versions are pinned to match dsh-workbuddy-connect 0.7.1 (and its own peers), so this list is deterministic; regenerate it if that version changes.",
  "dependencies": {
    "dsh-workbuddy-connect": "0.7.1",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-group": "1.0.4",
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/cosmokit": "1.8.5",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-authorization": "0.2.0-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.0-rc.2",
    "@deepseek-ai/dsh-config-editor": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2",
    "@deepseek-ai/dsh-package-manifest": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-crypto": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@earendil-works/pi-ai": "^0.87.1",
    "react": "^18.3.1"
  },
  "optionalDependencies": {
    "selfsigned": "^5.5.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "scripts": {
    "start": "node bin/bridge.js",
    "doctor": "node bin/bridge.js --doctor",
    "preflight": "node scripts/prepublish-check.js",
    "prepublishOnly": "node scripts/prepublish-check.js"
  }
}
